PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/school_dashboard

# API-only backend (recommended). Frontend runs separately on port 8080.
# Set SERVE_STATIC=false so /api/* never falls back to React index.html.
SERVE_STATIC=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://educore-school-erp-1ha7.arcada.app
# CORS_ORIGIN=https://educore-school-erp-1ha7.arcada.app

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EduCore School ERP <no-reply@educore.edu>"

# Migration (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=


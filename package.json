{
  "name": "school-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js Express + MongoDB API for EduCore school dashboard",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "seed": "node src/seed.js",
    "migrate:supabase": "node scripts/migrateFromSupabase.js",
    "upgrade:legacy-auth": "node scripts/upgradeLegacyAuth.js",
    "normalize:users": "node scripts/normalizeUsersCollection.js",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.14.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
